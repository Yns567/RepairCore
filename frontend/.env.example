# Runtime database URL. On Neon, use the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/repair_core?sslmode=require"

# Migration URL. On Neon, use the direct (non-pooler) connection string.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/repair_core?sslmode=require"

# Generate these with a password manager or `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"
# Protects IMEI values at rest. Generate an independent 32-byte base64 key.
DATA_ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"

# Set these after choosing your production domain.
AUTH_URL="https://your-project.vercel.app"
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# Product images: connect a public Vercel Blob store to the project.
# Vercel injects BLOB_STORE_ID and supplies OIDC through the Function request.
# A read/write token is optional and should only be used for local Blob access.
BLOB_READ_WRITE_TOKEN=""

# Email (password reset + notifications) via https://resend.com. Without a key,
# emails are only printed in the server log.
RESEND_API_KEY=""
EMAIL_FROM="RepairCore <no-reply@your-domain.com>"

# Bank accounts shown on the top-up page (JSON array).
BANK_ACCOUNTS_JSON='[{"bank":"CIH Bank","holder":"RepairCore","rib":"000 000 0000000000000000 00"}]'

# Google Cloud: when set, product images go to this Cloud Storage bucket instead
# of Vercel Blob. Must also be set at build time (see cloudbuild.yaml).
GCS_BUCKET=""
